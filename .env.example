COMPOSE_PROJECT_NAME=ruiwen
TZ=Asia/Shanghai
DOCKER_PLATFORM=linux/amd64
IMAGE_TAG=latest
BACKEND_IMAGE=ruiwen-backend
FRONTEND_IMAGE=ruiwen-frontend

FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080

# Local backend runtime connections.
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ruiwen?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

MYSQL_IMAGE=mysql:8.0
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ruiwen
MYSQL_ROOT_PASSWORD=7By6JOUx6gM0MJTSAW35YJZ4s3fAhEbRlFq8smszmE6wsFjf

REDIS_IMAGE=redis:7.2-alpine
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=DLlmjIqnQ5YZCdXc3NfBHalC6mRMihq7vO98n4rWehKOIfqF
REDIS_DATABASE=0

KAFKA_IMAGE=apache/kafka:3.7.0
KAFKA_BIND=127.0.0.1
KAFKA_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=4L62no9pSFm676Y8v_A9LA

ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.2.1
ELASTICSEARCH_BIND=127.0.0.1
ELASTICSEARCH_PORT=9201
ELASTICSEARCH_URIS=http://localhost:9201
ES_JAVA_OPTS=-Xms512m -Xmx512m

CANAL_IMAGE=canal/canal-server:v1.1.7
CANAL_PLATFORM=linux/amd64
CANAL_BIND=127.0.0.1
CANAL_PORT=11111
CANAL_HOST=localhost
CANAL_DESTINATION=example
CANAL_USERNAME=canal
CANAL_PASSWORD=ZCVWHi2wsTesQzy0TfoF0sxMGE5PwLWZXUj8g6qhp87s73Kv
CANAL_FILTER=ruiwen\.outbox

NGINX_IMAGE=nginx:1.27-alpine
NEXT_PUBLIC_API_BASE_URL=http://backend:8080

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.8

OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
OPENAI_EMBEDDING_MODEL=text-embedding-v4
OPENAI_EMBEDDING_DIMENSIONS=1536
VECTORSTORE_INITIALIZE_SCHEMA=true
VECTORSTORE_INDEX_NAME=ruiwen-ai-index

# 语音转文字（ASR）— 实时流式 paraformer-realtime-v2 WebSocket（独立于 OPENAI_*）
DASHSCOPE_ASR_API_KEY=
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
ASR_MODEL=paraformer-realtime-v2

# 图片识别（QVQ 视觉模型）- 与 OPENAI_API_KEY 同一 DashScope 账号；留空则回退到 OPENAI_API_KEY
DASHSCOPE_API_KEY=
QVQ_BASE_URL=https://llm-ciuhew9j1jjrvz3f.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QVQ_MODEL=qvq-plus

OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_DOMAIN=
OSS_FOLDER=avatars

GUO_YANG_CODE_KEY=

# Google OAuth 登录：前端 GIS 按钮 + 后端校验 ID Token 共用同一个 Client ID
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 后端拉 Google JWKS 公钥的出墙代理（国内服务器必填，否则校验会超时）；host 留空=直连
# 例：GOOGLE_PROXY_HOST=127.0.0.1  GOOGLE_PROXY_PORT=7890  GOOGLE_PROXY_TYPE=HTTP
GOOGLE_PROXY_HOST=
GOOGLE_PROXY_PORT=0
GOOGLE_PROXY_TYPE=HTTP

# 后台管理：首个超级管理员引导（启动时自动将该手机号/邮箱提升为 SUPER_ADMIN）
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_IDENTIFIER=
