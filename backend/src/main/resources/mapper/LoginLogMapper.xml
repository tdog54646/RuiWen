<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tongji.auth.audit.LoginLogMapper">

    <resultMap id="LoginLogResultMap" type="com.tongji.auth.audit.LoginLog">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="identifier" property="identifier"/>
        <result column="channel" property="channel"/>
        <result column="ip" property="ip"/>
        <result column="user_agent" property="userAgent"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.tongji.auth.audit.LoginLog"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO login_logs (
            user_id,
            identifier,
            channel,
            ip,
            user_agent,
            status,
            created_at
        ) VALUES (
            #{userId},
            #{identifier},
            #{channel},
            #{ip},
            #{userAgent},
            #{status},
            #{createdAt}
        )
    </insert>

    <!-- ===================== 后台审计 ===================== -->

    <select id="listPage" resultMap="LoginLogResultMap">
        SELECT *
        FROM login_logs
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="identifier != null and identifier != ''">
                AND identifier LIKE CONCAT('%', #{identifier}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="channel != null and channel != ''">
                AND channel = #{channel}
            </if>
            <if test="start != null">
                AND created_at &gt;= #{start}
            </if>
            <if test="end != null">
                AND created_at &lt;= #{end}
            </if>
        </where>
        ORDER BY created_at DESC, id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*)
        FROM login_logs
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="identifier != null and identifier != ''">
                AND identifier LIKE CONCAT('%', #{identifier}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="channel != null and channel != ''">
                AND channel = #{channel}
            </if>
            <if test="start != null">
                AND created_at &gt;= #{start}
            </if>
            <if test="end != null">
                AND created_at &lt;= #{end}
            </if>
        </where>
    </select>

    <select id="countSince" resultType="long">
        SELECT COUNT(*)
        FROM login_logs
        WHERE status = 'SUCCESS'
          AND created_at &gt;= #{since}
    </select>

</mapper>
